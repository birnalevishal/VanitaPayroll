                <TablixMember>
                  <Group Name="MonYrcd">
                    <GroupExpressions>
                      <GroupExpression>=Fields!MonYrcd.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Right(Fields!MonYrcd.Value,4)+Left(Fields!MonYrcd.Value,2)</Value>
                    </SortExpression>
                  </SortExpressions>
                  <TablixHeader>
                    <Size>0.25in</Size>
                    <CellContents>
                      <Textbox Name="MonYrcd">
                        <CanGrow>true</CanGrow>
                        <KeepTogether>true</KeepTogether>
                        <Paragraphs>
                          <Paragraph>
                            <TextRuns>
                              <TextRun>
                                <Value>=Switch(left(Fields!MonYrcd.Value,2) = "01", "Jan " &amp; right(Fields!MonYrcd.Value,4), 
         left(Fields!MonYrcd.Value,2) = "02", "Feb " &amp; right(Fields!MonYrcd.Value,4),
         left(Fields!MonYrcd.Value,2) = "03", "Mar " &amp; right(Fields!MonYrcd.Value,4),
		 left(Fields!MonYrcd.Value,2) = "04", "Apr " &amp; right(Fields!MonYrcd.Value,4), 
         left(Fields!MonYrcd.Value,2) = "05", "May " &amp; right(Fields!MonYrcd.Value,4),
         left(Fields!MonYrcd.Value,2) = "06", "Jun " &amp; right(Fields!MonYrcd.Value,4),

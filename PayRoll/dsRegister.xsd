          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="Udf_AdvanceDetailTableAdapter" GeneratorDataComponentClassName="Udf_AdvanceDetailTableAdapter" Name="Udf_AdvanceDetail" UserDataComponentName="Udf_AdvanceDetailTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="VanitaPayrollConnectionString (Web.config)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT        TOP (100) PERCENT udf_AdvanceDetailsFY1_1.OrgId, udf_AdvanceDetailsFY1_1.Employeecd, udf_AdvanceDetailsFY1_1.Employeename, udf_AdvanceDetailsFY1_1.AdvApplicationDate, 
                         udf_AdvanceDetailsFY1_1.SanctionDate, udf_AdvanceDetailsFY1_1.Advamount, ISNULL(udf_AdvanceDetailsFY1_1.Advamount, 0) - ISNULL(udf_AdvanceDetailsFYopening_1.ope, 0) AS ope, 
                         udf_AdvanceDetailsFYmonthly_1.MonYrCd, udf_AdvanceDetailsFYmonthly_1.monthly, udf_AdvanceDetailsFY1dedtotal_1.Amount
FROM            dbo.udf_AdvanceDetailsFY1(@OrgID, @fromDt, @ToDt) AS udf_AdvanceDetailsFY1_1 LEFT OUTER JOIN
                         dbo.udf_AdvanceDetailsFY1dedtotal(@ToMonYrCd) AS udf_AdvanceDetailsFY1dedtotal_1 ON udf_AdvanceDetailsFY1_1.OrgId = udf_AdvanceDetailsFY1dedtotal_1.OrgId AND 
                         udf_AdvanceDetailsFY1_1.Employeecd = udf_AdvanceDetailsFY1dedtotal_1.Employeecd AND 
                         udf_AdvanceDetailsFY1_1.AdvApplicationDate = udf_AdvanceDetailsFY1dedtotal_1.AdvApplicationDate LEFT OUTER JOIN
                         dbo.udf_AdvanceDetailsFYmonthly(@FromMonYrCd, @ToMonYrCd) AS udf_AdvanceDetailsFYmonthly_1 ON udf_AdvanceDetailsFY1_1.OrgId = udf_AdvanceDetailsFYmonthly_1.OrgId AND 
                         udf_AdvanceDetailsFY1_1.Employeecd = udf_AdvanceDetailsFYmonthly_1.Employeecd AND 
                         udf_AdvanceDetailsFY1_1.AdvApplicationDate = udf_AdvanceDetailsFYmonthly_1.AdvApplicationDate LEFT OUTER JOIN
                         dbo.udf_AdvanceDetailsFYopening(@FromMonYrCd) AS udf_AdvanceDetailsFYopening_1 ON udf_AdvanceDetailsFY1_1.OrgId = udf_AdvanceDetailsFYopening_1.OrgId AND 
                         udf_AdvanceDetailsFY1_1.Employeecd = udf_AdvanceDetailsFYopening_1.Employeecd AND udf_AdvanceDetailsFY1_1.AdvApplicationDate = udf_AdvanceDetailsFYopening_1.AdvApplicationDate
WHERE        (ISNULL(udf_AdvanceDetailsFY1_1.Advamount, 0) - ISNULL(udf_AdvanceDetailsFY1dedtotal_1.Amount, 0) &gt; 0)
ORDER BY udf_AdvanceDetailsFY1_1.Employeecd, RIGHT(udf_AdvanceDetailsFYmonthly_1.MonYrCd, 4) + LEFT(udf_AdvanceDetailsFYmonthly_1.MonYrCd, 2)</CommandText>
